NODE_ENV=development
SERVICE_PORT=3000
DOMAIN=localhost

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=realtime_chat

JWT_ACCESS_SECRET=change-me
JWT_PASSWORD_RESET_SECRET=change-me
EMAIL_ENC_KEY=1234567890123456789012345678901212345678901234567890123456789012

# Redis: presence + Socket.io adapter (omit to fall back to in-process sockets)
REDIS_URL=redis://localhost:6379

# Kafka: chat.message.created → push worker (omit to fall back to in-app push)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=realtime-chat
KAFKA_GROUP_ID=realtime-chat-push
