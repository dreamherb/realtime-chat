{
  "name": "realtime-chat",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "env-cmd -f .env.development nodemon app.js",
    "worker:chat": "env-cmd -f .env.development node workers/chat-message.worker.js",
    "local:up": "docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build",
    "local:down": "docker compose -f docker-compose.yml -f docker-compose.local.yml down",
    "local:logs": "docker compose -f docker-compose.yml -f docker-compose.local.yml logs -f app worker",
    "infra:up": "docker compose -f docker-compose.yml -f docker-compose.local.yml up -d redis elasticmq",
    "infra:down": "docker compose -f docker-compose.yml -f docker-compose.local.yml down",
    "prod:up": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d",
    "prod:down": "docker compose -f docker-compose.yml -f docker-compose.prod.yml down",
    "prod:logs": "docker compose -f docker-compose.yml -f docker-compose.prod.yml logs -f app worker"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamherb/realtime-chat.git"
  },
  "keywords": [],
  "author": "dreamherb",
  "private": true,
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/dreamherb/realtime-chat/issues"
  },
  "homepage": "https://github.com/dreamherb/realtime-chat#readme",
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1106.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "cookie": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.1",
    "ejs": "^3.1.10",
    "env-cmd": "^11.0.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "mysql2": "^3.20.0",
    "nodemailer": "^8.0.7",
    "path": "^0.12.7",
    "redis": "^6.2.1",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "yarn": "^1.22.22"
  }
}
