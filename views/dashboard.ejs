<!doctype html>
<html lang="ko">
<%- include('include/header', { title: "Dashboard" }) %>

  <body>
    <main class="page">
      <section class="section section--dashboard">
        <aside class="sidebar">
          <div class="sidebar__header">
            <h2 class="sidebar__user">
              <%= user && user.name ? user.name : "User" %>
            </h2>
            <div class="sidebar__actions">
              <a class="btn btn--secondary btn--block" href="/chats/new">＋ New chat</a>
              <a class="btn btn--secondary btn--block" href="/groups/new">＋ New group</a>
            </div>
          </div>

          <nav class="roomlist">
            <% if (!(rooms || []).length) { %>
              <p class="muted roomlist__empty">참여 중인 채팅방이 없습니다.</p>
            <% } %>
            <% (rooms || []).forEach(function(r){ %>
              <a class="roomlist__item<%= selectedRoomId == r.id ? ' is-active' : '' %><%= r.unreadCount > 0 && selectedRoomId != r.id ? ' roomlist__item--unread' : '' %>"
                href="/dashboard?roomId=<%= r.id %>"
                data-room-id="<%= r.id %>"
                data-unread-count="<%= r.unreadCount || 0 %>">
                <span class="roomlist__item-body">
                  <span class="roomlist__item-name"><%= r.type === 'DM' ? '' : '# ' %><%= r.name %></span>
                  <span class="roomlist__item-preview"<% if (!r.unreadPreview) { %> hidden<% } %>><%= r.unreadPreview || '' %></span>
                </span>
                <span class="roomlist__badge"<% if (!(r.unreadCount > 0)) { %> hidden<% } %> aria-label="읽지 않은 메시지"><%= r.unreadCount > 99 ? '99+' : (r.unreadCount || '') %></span>
              </a>
            <% }) %>
          </nav>

          <% if ((joinableGroups || []).length) { %>
          <h3 class="roomlist__section-title">참여 가능한 그룹</h3>
          <nav class="roomlist roomlist--joinable">
            <% joinableGroups.forEach(function(g){ %>
              <div class="roomlist__joinable-item">
                <span class="roomlist__joinable-name"># <%= g.name %></span>
                <button
                  class="btn btn--secondary btn--xs js-join-group"
                  type="button"
                  data-room-id="<%= g.id %>"
                >참여</button>
              </div>
            <% }) %>
          </nav>
          <% } %>
        </aside>

        <section class="chat">
          <header class="chat__header">
            <div class="row row--gap-sm row--center">
              <% if (selectedRoomId) { %>
              <button
                type="button"
                class="btn btn--ghost btn--xs js-leave-room"
                data-room-id="<%= selectedRoomId %>"
                title="채팅방 나가기"
                aria-label="채팅방 나가기"
              >←</button>
              <% } %>
              <h3 class="chat__title">
                <%= currentRoom %>
              </h3>
            </div>
            <div class="row row--gap-sm">
              <a class="btn btn--secondary" href="/notifications">Notifications</a>
              <a class="btn btn--secondary" href="/invite">Invite</a>
              <a class="btn btn--secondary" href="/settings">Settings</a>
              <button class="btn btn--secondary js-logout" type="button">로그아웃</button>
            </div>
          </header>

          <div class="chat__messages" id="messages">
            <% if (selectedRoomId && !(messages || []).length) { %>
              <p class="muted">아직 메시지가 없습니다.</p>
            <% } %>
            <% if (!selectedRoomId) { %>
              <p class="muted">왼쪽에서 채팅방을 선택하거나 새 채팅을 만드세요.</p>
            <% } %>
            <% (messages || []).forEach(function(m){ %>
              <% if (m.type === 'SYSTEM_JOIN' || m.type === 'SYSTEM_LEAVE') { %>
                <div class="msg msg--system">
                  <span class="msg--system__body">
                    <%= m.from %>님이 <%= m.type === 'SYSTEM_JOIN' ? '입장' : '퇴장' %>했습니다.
                  </span>
                  <span class="msg--system__time"><%= m.time %></span>
                </div>
              <% } else { %>
                <article class="msg <%= m.from === (user && user.name) ? 'msg--me' : '' %>">
                  <div class="msg__meta">
                    <%= m.from %> · <%= m.time %>
                  </div>
                  <div class="msg__body">
                    <%= m.text %>
                  </div>
                </article>
              <% } %>
            <% }) %>
          </div>

          <% if (selectedRoomId) { %>
          <form class="chat__composer" id="messageForm" data-room-id="<%= selectedRoomId %>">
            <input
              class="input input--grow"
              type="text"
              name="text"
              id="messageText"
              placeholder="메시지를 입력하세요"
              autocomplete="off"
            />
            <button class="btn btn--primary" type="submit">Send</button>
          </form>
          <% } %>
        </section>
      </section>
    </main>
    <%- include('include/footer') %>
    <div class="modal-overlay" id="alertModalOverlay">
      <div class="modal" id="alertModal">
        <h2>Notice</h2>
        <p id="alertModalMsg"></p>
        <button onclick="closeAlertModal()">확인</button>
      </div>
    </div>
    <script src="/js/common.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script>
      window.__DASHBOARD__ = {
        roomId: <%- JSON.stringify(selectedRoomId || null) %>,
        currentUser: <%- JSON.stringify(user.name) %>,
        lastMessageId: <%- JSON.stringify((messages && messages.length ? messages[messages.length - 1].id : 0)) %>,
        rooms: <%- JSON.stringify((rooms || []).map(function(r) {
          return { id: r.id, type: r.type, name: r.name, unreadCount: r.unreadCount || 0, unreadPreview: r.unreadPreview || null };
        })) %>
      };
    </script>
    <script src="/js/dashboard.js"></script>
  </body>
</html>
